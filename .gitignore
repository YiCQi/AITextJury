# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Node
node_modules/
apps/web/dist/
# ...but the built web UI IS shipped inside the API package so end users
# (who may not have Node) get the workbench at :8000 straight from
# `python -m zeroaibench`. Rebuild: cd apps/web && npm run build, then copy
# dist/* -> ../api/zeroaibench/static/
!apps/api/zeroaibench/static
!apps/api/zeroaibench/static/**
*.tsbuildinfo

# Runtime data (history, keys, cache, calibration) — stays on your machine
data/history/
data/cache/
data/calibration/
data/providers.json
data/settings.json
data/plugins/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Local agent workspace / scratch files
.aionrs/
.smoke_*
.gitcommit-msg*.txt
